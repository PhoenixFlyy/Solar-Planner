# Solar Planner — environment template.
# Copied to .env.local by `pnpm run setup`. Never commit .env.local.
# .env.local is read by the FastAPI backend (pydantic-settings) and,
# for NEXT_PUBLIC_* keys, mirrored into apps/web/.env.local.

# ----------------------------------------------------------------------
# Backend (apps/api) — local defaults match infra/docker-compose.yml
# ----------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg://solar:solar@localhost:5432/solar

# Redis (adapter cache + arq job queue, when introduced)
REDIS_URL=redis://localhost:6379/0

# MinIO (S3-compatible, local object storage)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=solar-planner

# External data sources (all free, no API key required in MVP)
PHOTON_BASE_URL=https://photon.komoot.io
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_2

# Disk cache (hishel) for external HTTP calls
HTTP_CACHE_DIR=.cache/http

# Error tracking (optional — leave blank to disable)
SENTRY_DSN=

# ----------------------------------------------------------------------
# Frontend (apps/web) — only NEXT_PUBLIC_* are exposed to the browser
# ----------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=de
NEXT_PUBLIC_SENTRY_DSN=

# Cesium ion access token (free tier) — enables the real-world 3D view
# (ADR-0008). Leave blank to keep the R3F editor only. Free account at
# https://ion.cesium.com
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# ----------------------------------------------------------------------
# Supabase (optional — only for online-preview deploys, not local MVP)
# ----------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
